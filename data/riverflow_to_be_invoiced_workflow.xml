<?xml version="1.0"?>
<odoo noupdate="0">
    <!-- Workflow -->
    <record id="workflow_to_be_invoiced" model="riverflow.workflow">
        <field name="model_id" ref="riverflow.model_riverflow_service" />
        <field name="name">To Be Invoiced</field>
        <field name="description">Workflow for managing invoicing</field>
        <field name="icon">fa-file-invoice-dollar</field>
        <field name="is_supply_order">False</field>
        <field name="has_supply_quantity">False</field>
        <field name="has_supplier">False</field>
        <field name="has_supply_unit_price">False</field>
    </record>

    <!-- Define all states first (to prevent forward references) -->
    <record id="state_to_be_invoiced" model="riverflow.state">
        <field name="workflow_id" ref="workflow_to_be_invoiced" />
        <field name="name">To Be Invoiced</field>
        <field name="sequence">10</field>
    </record>

    <record id="state_ready_for_invoicing" model="riverflow.state">
        <field name="workflow_id" ref="workflow_to_be_invoiced" />
        <field name="name">Ready for Invoicing</field>
        <field name="sequence">20</field>
    </record>

    <record id="state_invoiced" model="riverflow.state">
        <field name="workflow_id" ref="workflow_to_be_invoiced" />
        <field name="name">Invoiced</field>
        <field name="sequence">30</field>
        <field name="is_end_state">True</field>
    </record>

