<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="service_Eendracht" model="riverflow.service">
            <field name="name">Eendracht</field>
            <field name="project_deadline" eval="DateTime.now() + relativedelta(days=30)" />
        </record>
        <record id="service_Eendracht_Onboard" model="riverflow.service">
            <field name="name">Onboarding via ODI</field>
            <field name="parent_id" ref="service_Eendracht" />
            <field name="days_relative_to_project">-30</field>
        </record>
        <record id="service_Eendracht_Onboard_findapp" model="riverflow.service">
            <field name="name">Confirm with Client</field>
            <field name="parent_id" ref="service_Eendracht_Onboard" />
            <field name="days_relative_to_project">-30</field>
            <field name="tag_ids" eval="[(4,ref('service_tag_alert'))]" />
        </record>
        <record id="service_Eendracht_Onboard_arrangevisaflight" model="riverflow.service">
            <field name="name">Flight arrangement</field>
            <field name="parent_id" ref="service_Eendracht_Onboard" />
            <field name="days_relative_to_project">-28</field>
        </record>
        <record id="service_Eendracht_Onboard_arrangegroundtransport" model="riverflow.service">
            <field name="name">Ground transport to ship</field>
            <field name="parent_id" ref="service_Eendracht_Onboard" />
            <field name="days_relative_to_project">-5</field>
        </record>

    </data>
</odoo>