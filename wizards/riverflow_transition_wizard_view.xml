<odoo>
    <record id="view_transition_wizard_form" model="ir.ui.view">
        <field name="name">riverflow.transition.wizard.form</field>
        <field name="model">riverflow.transition.wizard</field>
        <field name="arch" type="xml">
            <form string="Transition Wizard">
                <sheet>
                    <group>
                        <field name="transition_description" readonly="1" invisible="transition_description_invisible or not transition_description" />
                        <field name="transition_description_invisible" invisible="1" />
                        <field name="records_to_transition_ids" invisible="1" />
                        <field name="transition_id" invisible="1" />
                        <field name="responsible_team_id" required="1" invisible="responsible_team_id_invisible" />
                        <field name="responsible_team_id_invisible" invisible="1" />

                        <field name="new_note" required="0" invisible="new_note_invisible" widget="html" />
                        <field name="new_note_invisible" invisible="1" />
                    </group>
                </sheet>
                <footer>
                    <button string="OK" type="object" name="action_save" class="btn-primary" data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>