<odoo>
    <record id="view_service_new_wizard_form" model="ir.ui.view">
        <field name="name">riverflow.start.service.form</field>
        <field name="model">riverflow.start.service</field>
        <field name="arch" type="xml">
            <form string="New Log-Entry">
                <sheet>
                    <field name="start_transition_ids" invisible="1" />
                    <field name="transition_buttons_json" widget="transition_buttons" />
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>