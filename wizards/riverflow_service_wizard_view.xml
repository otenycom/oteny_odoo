<odoo>
    <record id="view_service_transition_action_default_form" model="ir.ui.view">
        <field name="name">service.wizard.form</field>
        <field name="model">riverflow.service.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Service">
                <group>
                    <field name="service_ids" invisible="1" />
                    <field name="transition_id" invisible="1" />
                    <field name="transition_description" readonly="1" invisible="not transition_description" />
                    <field name="new_remark" required="0"
                        invisible="context.get('new_remark_invisible', False)" widget="html" />
                    <field name="name" readonly="context.get('name_readonly', True)" invisible="1" required="1" />
                    <field name="days_relative_to_project"
                        invisible="context.get('days_relative_to_project_invisible')" />
                </group>
                <footer>
                    <button string="OK" type="object" name="action_save" class="btn-primary"
                        data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>