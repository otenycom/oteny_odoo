<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- oteny.bot -->
    <record id="oteny_bot_view_list" model="ir.ui.view">
        <field name="name">oteny.bot.list</field>
        <field name="model">oteny.bot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bot_user_id"/>
                <field name="discuss_channel_id"/>
                <field name="uplink_ref"/>
                <field name="session_count"/>
            </list>
        </field>
    </record>

    <record id="oteny_bot_view_form" model="ir.ui.view">
        <field name="name">oteny.bot.form</field>
        <field name="model">oteny.bot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sessions" type="object" class="oe_stat_button" icon="fa-comments-o">
                            <field name="session_count" widget="statinfo" string="Exchanges"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert">
                        If Discuss is silent for this bot, check
                        <code>oteny traces --ref &lt;uplink_ref&gt;</code> for
                        <code>uplink_status</code> (<code>auth_failed</code> → re-mint / re-provision).
                        Website login is not the Talent debug path.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="bot_user_id"/>
                        <field name="discuss_channel_id"/>
                        <field name="uplink_ref"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Role Channels" name="role_channels">
                            <div class="alert alert-info" role="alert">
                                Bind one of this bot's declared roles to a room and the bot
                                answers there with that role's own persona and preloaded
                                skills, and its workflow dispatches land there. Rooms you
                                simply add the bot to still work — it answers with its general
                                desk persona. Role names come from the bot's Talent; a typo
                                silently leaves the room general.
                            </div>
                            <field name="channel_ids">
                                <list editable="bottom">
                                    <field name="role"/>
                                    <field name="channel_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oteny_bot_action" model="ir.actions.act_window">
        <field name="name">Bots</field>
        <field name="res_model">oteny.bot</field>
        <field name="view_mode">list,form</field>
        <field name="path">oteny-bots</field>
    </record>

    <!-- oteny.bot.session -->
    <record id="oteny_bot_session_view_list" model="ir.ui.view">
        <field name="name">oteny.bot.session.list</field>
        <field name="model">oteny.bot.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="started_at"/>
                <field name="bot_id"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="outcome" widget="badge"
                       decoration-success="outcome == 'ok'"
                       decoration-warning="outcome == 'halted' or outcome == 'escalated'"
                       decoration-danger="outcome == 'error' or outcome == 'timeout'"/>
                <field name="browser_status" optional="show"/>
                <field name="outcome_detail" optional="show"/>
                <field name="turn_count"/>
                <field name="tool_call_count"/>
                <field name="duration_s"/>
            </list>
        </field>
    </record>

    <record id="oteny_bot_session_view_form" model="ir.ui.view">
        <field name="name">oteny.bot.session.form</field>
        <field name="model">oteny.bot.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_watch_live_browser" type="object"
                            string="Watch live browser"
                            class="btn-primary"
                            invisible="not has_browser_session or outcome != 'dispatched'"
                            groups="base.group_user"/>
                    <button name="action_replay_browser" type="object"
                            string="Replay browser session"
                            invisible="not has_browser_session or outcome == 'dispatched'"
                            groups="base.group_user"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bot_id"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="outcome"/>
                            <field name="outcome_detail"/>
                            <field name="browser_status"/>
                            <field name="has_browser_session" invisible="1"/>
                            <field name="browser_session_ids" invisible="1"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="duration_s"/>
                            <field name="origin_model"/>
                            <field name="origin_res_id"/>
                            <field name="work_token" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request"><field name="request"/></page>
                        <page string="Response"><field name="response"/></page>
                        <page string="Turns">
                            <field name="turn_ids">
                                <list>
                                    <field name="sequence"/>
                                    <field name="llm_model"/>
                                    <field name="tool_call_count"/>
                                    <field name="tokens_in"/>
                                    <field name="tokens_out"/>
                                    <field name="duration_s"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oteny_bot_session_action" model="ir.actions.act_window">
        <field name="name">Activity Log</field>
        <field name="res_model">oteny.bot.session</field>
        <field name="view_mode">list,form</field>
        <field name="path">oteny-bot-activity</field>
    </record>

    <!-- oteny.bot.turn (drill-in) -->
    <record id="oteny_bot_turn_view_form" model="ir.ui.view">
        <field name="name">oteny.bot.turn.form</field>
        <field name="model">oteny.bot.turn</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="llm_model"/>
                        <field name="tool_call_count"/>
                    </group>
                    <notebook>
                        <page string="System Prompt"><field name="system_prompt"/></page>
                        <page string="User Message"><field name="user_message"/></page>
                        <page string="LLM Response"><field name="llm_response"/></page>
                        <page string="Tool Calls"><field name="tool_calls" widget="json"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- menu (manager-gated) -->
    <menuitem id="oteny_bot_menu_root" name="Oteny Bots" sequence="90"
              groups="oteny_bot.group_oteny_bot_manager"/>
    <menuitem id="oteny_bot_menu_bots" name="Bots" parent="oteny_bot_menu_root"
              action="oteny_bot_action" sequence="10"/>
    <menuitem id="oteny_bot_menu_activity" name="Activity Log" parent="oteny_bot_menu_root"
              action="oteny_bot_session_action" sequence="20"/>
</odoo>
