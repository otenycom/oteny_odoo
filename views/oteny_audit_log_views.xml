<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id='oteny_audit_log_view_list' model='ir.ui.view'>
        <field name='name'>oteny.audit.log.list</field>
        <field name='model'>oteny.audit.log</field>
        <field name='arch' type='xml'>
            <list string="Audit Log" create="false" edit="false">
                <field name="create_date" string="Timestamp" optional="show" />
                <field name="create_uid" string="User" optional="show" widget="many2one_avatar_user" />
                <field name="model_name" optional="show" />
                <field name="record_id" optional="show" />
                <field name="record_display_name" optional="show" />
                <field name="field_name" optional="show" />
                <field name="old_value" optional="show" />
                <field name="old_value_display_name" optional="show" />
                <field name="new_value" optional="show" />
                <field name="new_value_display_name" optional="show" />
                <field name="change_type" optional="show" />
            </list>
        </field>
    </record>

    <record id='oteny_audit_log_view_form' model='ir.ui.view'>
        <field name="name">oteny.audit.log.form</field>
        <field name="model">oteny.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Timestamp" readonly="1" />
                            <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" />
                            <field name="change_type" readonly="1" />
                        </group>
                        <group>
                            <field name="model_name" readonly="1" />
                            <field name="record_id" readonly="1" />
                            <field name="record_display_name" readonly="1" />
                            <field name="field_name" readonly="1" />
                        </group>
                    </group>
                    <group string="Changed Values">
                        <label for="old_value" />
                        <div>
                            <field name="old_value" readonly="1" class="oe_inline" />
                            <field name="old_value_display_name" readonly="1" class="oe_inline" invisible="old_value == old_value_display_name" />
                        </div>
                        <label for="new_value" />
                        <div>
                            <field name="new_value" readonly="1" class="oe_inline" />
                            <field name="new_value_display_name" readonly="1" class="oe_inline" invisible="new_value == new_value_display_name" />
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oteny_audit_log_view_search" model="ir.ui.view">
        <field name="name">oteny.audit.log.search</field>
        <field name="model">oteny.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">
                <field name="model_name" />
                <field name="field_name" />
                <field name="record_id" />
                <field name="record_display_name" />
                <field name="change_type" />
                <field name="old_value" />
                <field name="new_value" />
                <field name="old_value_display_name" />
                <field name="new_value_display_name" />
                <field name="create_uid" />
                <separator />
                <filter string="Inserts" name="inserts" domain="[('change_type', '=', 'insert')]" />
                <filter string="Updates" name="updates" domain="[('change_type', '=', 'update')]" />
                <filter string="Deletes" name="deletes" domain="[('change_type', '=', 'delete')]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Model" name="group_by_model" context="{'group_by': 'model_name'}" />
                    <filter string="Record" name="group_by_record" context="{'group_by': 'record_display_name'}" />
                    <filter string="Field" name="group_by_field" context="{'group_by': 'field_name'}" />
                    <filter string="Change Type" name="group_by_change_type" context="{'group_by': 'change_type'}" />
                    <filter string="User" name="group_by_user" context="{'group_by': 'create_uid'}" />
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_oteny_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">oteny.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="search_view_id" ref="oteny_audit_log_view_search" />
    </record>

    <menuitem
        id="oteny_audit_log_menu_root"
        name="Audit"
        sequence="99"
    />

    <menuitem
        id="oteny_audit_log_menu"
        name="Log"
        parent="oteny_audit_log_menu_root"
        action="action_oteny_audit_log"
        sequence="10"
    />

</odoo>