<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_add_service_form" model="ir.ui.view">
        <field name="name">riverflow.auto.add.service.form</field>
        <field name="model">riverflow.auto.add.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <h2>
                            <field name="name" readonly="1" invisible="1" />
                        </h2>
                    </div>
                    <group>
                        <field name="active" invisible="1" />
                        <field name="service_template_id" />
                        <field name="description" placeholder="Description of the auto-add rule's purpose and behavior." />
                        <field name="applies_to_model_id" />
                        <field name="applies_to_model" readonly="1" invisible="1" />
                        <field name="domain" widget="domain" options="{'model': 'applies_to_model'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_auto_add_service_list" model="ir.ui.view">
        <field name="name">riverflow.auto.add.service.list</field>
        <field name="model">riverflow.auto.add.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="active" column_invisible="1" />
                <field name="name" optional="show" />
                <field name="applies_to_model_id" optional="show" />
                <field name="domain" optional="show" />
                <field name="description" optional="hide" />
                <field name="service_template_id" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_auto_add_service_search" model="ir.ui.view">
        <field name="name">riverflow.auto.add.service.search</field>
        <field name="model">riverflow.auto.add.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="applies_to_model_id" />
                <field name="service_template_id" />
                <separator />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
            </search>
        </field>
    </record>

    <record id="action_auto_add_service" model="ir.actions.act_window">
        <field name="name">Auto Add Services</field>
        <field name="res_model">riverflow.auto.add.service</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auto_add_service_search" />
    </record>

    <menuitem id="menu_auto_add_service"
        name="Auto Add Services"
        action="action_auto_add_service"
        parent="riverflow.services_configuration_menu" sequence="110"
    />
</odoo>