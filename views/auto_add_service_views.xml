<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_add_service_tree" model="ir.ui.view">
        <field name="name">riverflow.auto.add.service.tree</field>
        <field name="model">riverflow.auto.add.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="workflow_id" />
                <field name="res_model" />
            </tree>
        </field>
    </record>

    <record id="view_auto_add_service_form" model="ir.ui.view">
        <field name="name">riverflow.auto.add.service.form</field>
        <field name="model">riverflow.auto.add.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="workflow_id" />
                        <field name="res_model" />
                        <field name="domain" widget="domain" options="{'model': 'res_model'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auto_add_service" model="ir.actions.act_window">
        <field name="name">Auto Add Services</field>
        <field name="res_model">riverflow.auto.add.service</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_auto_add_service"
        name="Auto Add Services"
        action="action_auto_add_service"
        parent="menu_riverflow_configuration"
        sequence="20" />
</odoo>