<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="riverflow.workflow_view_form" model="ir.ui.view">
        <field name="name">riverflow.workflow.form</field>
        <field name="model">riverflow.workflow</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="active" invisible="True" />
                            <field name="name" class="w-100" on_change="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                    <group>
                        <field name="workflow_start_transition_ids">
                            <tree>
                                <field name="active" column_invisible="True" />
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="description" />
                                <field name="to_state_id" />
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="workflow_state_ids">
                            <tree>
                                <field name="active" column_invisible="True" />
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="description" />
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="riverflow.workflow_view_tree" model="ir.ui.view">
        <field name="name">riverflow.workflow.tree</field>
        <field name="model">riverflow.workflow</field>
        <field name="arch" type="xml">
            <tree string="Workflows">
                <field name="active" column_invisible="True" />
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="riverflow.workflow_action" model="ir.actions.act_window">
        <field name="name">Workflows</field>
        <field name="res_model">riverflow.workflow</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new workflow!
            </p>
        </field>
    </record>

    <menuitem id="riverflow.services_menu_configuration_workflows"
        parent="riverflow.services_configuration_menu" sequence="20"
        action="riverflow.workflow_action" />

</odoo>