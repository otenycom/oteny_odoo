<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="riverflow.workflow_state_view_form" model="ir.ui.view">
        <field name="name">riverflow.workflow.state.form</field>
        <field name="model">riverflow.workflow.state</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="active" invisible="True" />
                            <field name="name" class="w-100" on_change="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="workflow_id" readonly="1" />
                            <field name="description" />
                            <field name="isEndState" />
                        </group>
                    </group>
                    <group>
                        <field name="from_transition_ids">
                            <tree editable="bottom" create="1" delete="1" multi_edit="1" open_form_view="True">
                                <field name="active" column_invisible="True" />
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="from_state_id" />
                                <field name="to_state_id" />
                                <field name="description" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="riverflow.workflow_state_view_tree" model="ir.ui.view">
        <field name="name">riverflow.workflow.state.tree</field>
        <field name="model">riverflow.workflow.state</field>
        <field name="arch" type="xml">
            <tree string="Workflows">
                <field name="active" column_invisible="True" />
                <field name="sequence" widget="handle" />
                <field name="workflow_id" />
                <field name="name" />
                <field name="complete_name" optional="hide" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="riverflow.workflow_state_action" model="ir.actions.act_window">
        <field name="name">Workflow States</field>
        <field name="res_model">riverflow.workflow.state</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new workflow state!
            </p>
        </field>
    </record>

    <menuitem id="riverflow.services_menu_configuration_workflow_states"
        parent="riverflow.services_configuration_menu" sequence="30"
        action="riverflow.workflow_state_action" />

</odoo>