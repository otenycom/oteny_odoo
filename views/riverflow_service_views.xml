<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id='riverflow.view_service_form' model='ir.ui.view'>
        <field name="name">riverflow.service.form</field>
        <field name="model">riverflow.service</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Services" create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_parent_service"
                            invisible="not parent_id" class="oe_stat_button" icon="fa-bell">
                            <field name="parent_id" widget="statinfo" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" class="w-100" on_change="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model" invisible="1" />
                            <field name="workflow_id" on_change="1" invisible="transition_buttons_json" />
                            <field name="tag_ids" widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}" />
                            <field name="transition_buttons_json" widget="transition_buttons" />
                            <field name="internal_notes_summary" invisible="1" />
                            <field name="state_name" invisible="1" on_change="1" />
                            <field name="state_id" on_change="1" invisible="1" />
                        </group>
                        <group>
                            <field name="display_name" invisible="not parent_id" />
                            <!-- Make a workflow action 'move service' if we really need to edit the parent
                             its cluttering the screen here in the form view
                              -->
                            <field name="parent_id" on_change="1" can_create="False"
                                can_write="True" invisible="1" />
                            <field name="company_id" invisible="1" />
                            <field name="active" invisible="1" />
                            <field name="use_project_deadline_from" required="1" />
                            <field name="project_deadline" invisible="use_project_deadline_from != 'self'" on_change="1" />
                            <field name="related_project_deadline" invisible="use_project_deadline_from != 'root'" />
                            <field name="days_relative_to_project" invisible="use_project_deadline_from == 'self'"
                                on_change="1" />
                            <field name="timing_json" widget="timing_widget" />

                        </group>

                    </group>
                    <notebook>
                        <page string="Child Services" name="services">
                            <div>
                                <button name="add_child_service" type="object" class="oe_link" data-hotkey="n"
                                    icon="fa-plus">
                                    Add Child Service</button>
                            </div>
                            <field name="descendant_ids" invisible="not descendant_ids">
                                <!-- Workaround: tree view click opens a popup of the child service, instead of the form view.
                                 To ensure the form view opens for the child service, we set open_form_view="True". This requires the user 
                                 to click the 'view' button on the child service to open the form vie, so its not very user friendly. -->
                                <tree editable="bottom" create="0" delete="0" multi_edit="0" open_form_view="True">
                                    <field name="indented_name" optional="show" />
                                    <field name="name" optional="hide" />
                                    <field name="display_name" optional="hide" />
                                    <field name="transition_buttons_json" widget="transition_buttons" />
                                    <field name="timing_json" widget="timing_widget" optional="show" />
                                    <field name="deadline_formatted" optional="hide" />
                                    <field name="internal_notes_summary" />
                                    <field name="external_messages_summary" />
                                    <field name="unreviewed_message_count" />
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                                        readonly="1" />
                                </tree>
                            </field>
                        </page>
                        <page string="Unreviewed External Messages" name="unreviewed_messages">
                            <div>
                                <p>Review the External Messages in the Chatter,
                                    and once done and followup is complete, mark them as Reviewed</p>
                                <button name="action_mark_external_messages_reviewed" type="object" class="oe_link"
                                    string="Mark as Reviewed" icon="fa-check" />
                                <field name="last_external_message_review_time" />
                            </div>
                            <group>
                                <field name="unreviewed_message_count" />
                                <field name="message_from_external_sender_ids" />
                            </group>
                        </page>
                        <page string="External Messages" name="all_external_messages">
                            <span>Messages visible to third parties (customers, vendors, etc.),
                                or received from third party.</span>
                            <group>
                                <field name="external_messages_summary" />

                                <field name="external_message_ids" />
                            </group>
                        </page>
                        <page string="Internal Notes" name="internal_notes">
                            <field name="internal_note_ids" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <!-- <field name="activity_ids"/> -->
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id='riverflow.service_view_tree' model='ir.ui.view'>
        <field name='name'>riverflow.service.tree</field>
        <field name='model'>riverflow.service</field>
        <field name='arch' type='xml'>
            <tree string='Services' create="false">
                <field name="active" column_invisible="True" />
                <field name='indented_name' />
                <field name="timing_json" widget="timing_widget" optional="show" />
                <field name="deadline_formatted" optional="hide" />
                <field name="transition_buttons_json" widget="transition_buttons" />
                <field name="res_name" optional="show" />
                <!-- <field name="resource_ref" /> -->
                <field name="display_name" optional="hide" />
                <field name='internal_notes_summary' />
                <field name="external_messages_summary" />
                <field name="unreviewed_message_count" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                    readonly="1" />

                <!-- Uncomment to see how the padding and margin styles are applied -->
                <!-- <button name='action_button_click' type='object' string='Server'
                class='btn-primary' /> -->
            </tree>
        </field>
    </record>

    <record id='riverflow.service_action' model='ir.actions.act_window'>
        <field name='name'>Services</field>
        <field name='res_model'>riverflow.service</field>
        <field name="view_mode">tree,form</field>
        <field name='help' type='html'>
            <p class='o_view_nocontent_smiling_face'>
                Add a new service!
            </p>
        </field>
    </record>

    <record id="riverflow.service_tag_view_view_form" model="ir.ui.view">
        <field name="name">riverflow.service.tag.form</field>
        <field name="model">riverflow.service.tag</field>
        <field name="arch" type="xml">
            <form string="Service Tags">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="riverflow.service_tag_view_view_tree" model="ir.ui.view">
        <field name="name">riverflow.service.tag.tree</field>
        <field name="model">riverflow.service.tag</field>
        <field name="arch" type="xml">
            <tree string="Service Tags" editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <record id="riverflow.service_tag_action" model="ir.actions.act_window">
        <field name="name">Service Tags</field>
        <field name="res_model">riverflow.service.tag</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new service tag!
            </p>
        </field>
    </record>

    <!-- Define the action for the service start transition wizard -->
    <record id="action_riverflow_start_service" model="ir.actions.act_window">
        <field name="name">New Service</field>
        <field name="res_model">riverflow.start.service</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item Definitions 
    https://www.svgrepo.com/svg/455931/service-bell?edit=true 
    -->
    <menuitem id='riverflow.service_root' name='Services'
        web_icon='riverflow,static/description/icon.png'>
        <menuitem id="riverflow.services_menu" name="Services" action="riverflow.service_action" sequence="10" />
        <menuitem id="riverflow.services_configuration_menu" name="Configuration" sequence="20">
            <menuitem id="riverflow.services_menu_configuration_tags"
                action="riverflow.service_tag_action" sequence="10" />
        </menuitem>
        <menuitem id="riverflow.service_menu_new_service" name="&#10133; New Service"
            action="riverflow.action_riverflow_start_service" sequence="30" />
    </menuitem>

</odoo>