<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id='riverflow.service_view_form' model='ir.ui.view'>
        <field name="name">riverflow.service.form</field>
        <field name="model">riverflow.service</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button name="return_action_to_open"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-wrench"
                            context="{'xml_id':'fleet_vehicle_log_services_action', 'search_default_inactive': not active}"
                            invisible="service_activity != 'none'"
                            help="show the services logs for this vehicle">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button> -->
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" class="w-100" on_change="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model" invisible="1" />
                            <field name="workflow_id" on_change="1" invisible="transition_buttons_json" />
                            <field name="tag_ids" widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}" />
                            <field name="project_deadline" invisible="parent_id" on_change="1" />
                            <field name="related_project_deadline" invisible="not parent_id" />
                            <field name="days_relative_to_project" invisible="not parent_id"
                                on_change="1" />
                            <field name="timing" invisible="not parent_id" />
                            <field name='transition_buttons_json' widget="transition_buttons" />
                            <field name="latest_messages" invisible="1" />
                            <field name="workflow_state_name" invisible="1" on_change="1" />
                            <field name="workflow_state_id" on_change="1" invisible="1" />
                        </group>
                        <group>
                            <field name="display_name" invisible="not parent_id" />
                            <field name="parent_id" on_change="1" can_create="False"
                                can_write="True" />
                            <field name="company_id" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Child Services" name="services">
                            <field name="child_ids">
                                <tree string="Services" edit="true">
                                    <field name="name" optional="hide" />
                                    <field name="display_name" optional="show" />
                                    <field name="transition_buttons_json"
                                        widget="transition_buttons" />
                                    <field name="timing" optional="show" />
                                    <field name="deadline_formatted" optional="hide" />
                                    <field name="latest_messages" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <!-- <field name="activity_ids"/> -->
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id='riverflow.service_view_tree' model='ir.ui.view'>
        <field name='name'>riverflow.service.tree</field>
        <field name='model'>riverflow.service</field>
        <field name='arch' type='xml'>
            <tree string='Services' edit="true">
                <field name="active" column_invisible="True" />
                <field name='indented_name' />
                <field name='timing' optional="show" />
                <field name="deadline_formatted" optional="hide" />
                <field name='transition_buttons_json' widget="transition_buttons" />
                <field name="display_name" optional="hide" />
                <field name='latest_messages' />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                    readonly="1" />

                <!-- Uncomment to see how the padding and margin styles are applied -->
                <!-- <button name='action_button_click' type='object' string='Server'
                class='btn-primary' /> -->
            </tree>
        </field>
    </record>

    <record id='riverflow.service_action' model='ir.actions.act_window'>
        <field name='name'>Services</field>
        <field name='res_model'>riverflow.service</field>
        <field name="view_mode">tree,form</field>
        <field name='help' type='html'>
            <p class='o_view_nocontent_smiling_face'>
                Add a new service!
            </p>
        </field>
    </record>

    <record id="riverflow.service_tag_view_view_form" model="ir.ui.view">
        <field name="name">riverflow.service.tag.form</field>
        <field name="model">riverflow.service.tag</field>
        <field name="arch" type="xml">
            <form string="Service Tags">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="riverflow.service_tag_view_view_tree" model="ir.ui.view">
        <field name="name">riverflow.service.tag.tree</field>
        <field name="model">riverflow.service.tag</field>
        <field name="arch" type="xml">
            <tree string="Service Tags" editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </tree>
        </field>
    </record>

    <record id="riverflow.service_tag_action" model="ir.actions.act_window">
        <field name="name">Service Tags</field>
        <field name="res_model">riverflow.service.tag</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new service tag!
            </p>
        </field>
    </record>

    <!-- Menu Item Definitions 
    https://www.svgrepo.com/svg/455931/service-bell?edit=true 
    -->
    <menuitem id='riverflow.service_root' name='Services'
        web_icon='riverflow,static/description/icon.png'>
        <menuitem id="riverflow.services_menu" name="Services" action="riverflow.service_action">

        </menuitem>
        <menuitem id="riverflow.services_configuration_menu" name="Configuration">
            <menuitem id="riverflow.services_menu_configuration_tags"
                action="riverflow.service_tag_action" sequence="10" />
        </menuitem>
    </menuitem>

</odoo>