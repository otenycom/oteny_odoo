<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id='view_service_form' model='ir.ui.view'>
        <field name="name">riverflow.service.form</field>
        <field name="model">riverflow.service</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Services" create="false">
                <header>
                    <!-- see compileHeader(el, params) for btn in class="btn": this moves the transitions buttons to the left
                      in the slot where the normal Odoo buttons are -->
                    <field name="transition_buttons_json" widget="transition_buttons" max_buttons="5" layout="form_header" />
                    <!-- o_field_statusbar is needed because riverflow_statusbar inherits from o_field_statusbar, and its scss files only work inside o_field_statusbar -->
                    <field name="state_id" widget="riverflow_statusbar" readonly="1" class="o_field_statusbar" />
                    <field name="state_id_statusbar_json" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_parent_service"
                            invisible="not parent_id" class="oe_stat_button" icon="fa-bell">
                            <field name="parent_id" widget="statinfo" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Template" bg_color="text-bg-info"
                        invisible="not is_root_a_template" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h2>
                            <field name="name" class="w-100" on_change="1" />
                        </h2>
                    </div>
                    <group>
                        <group colspan="1">
                            <field name="state_name" invisible="1" on_change="1" />
                            <field name="state_id" on_change="1" invisible="1" />
                            <field name="model" invisible="1" />
                            <field name="workflow_id" on_change="1" invisible="transition_buttons_json" />
                            <field name="responsible_team_id" />
                            <field name="tag_ids" widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}" />
                            <field name="supply_order_service_id" invisible="not supply_order_service_id" />
                            <field name="internal_notes_summary" invisible="not internal_notes_summary" readonly="1" />
                            <field name="external_messages_summary" invisible="not external_messages_summary" readonly="1" />
                        </group>
                        <group colspan="1">
                            <field name="parent_id" on_change="1" can_create="False"
                                can_write="True" invisible="1" />
                            <field name="active" invisible="1" />
                            <field name="company_id" />

                            <field name="is_days_relative_to_project_applicable" invisible="1" />
                            <field name="use_project_deadline_from_options" invisible="1" />
                            <field name="use_project_deadline_from" widget="filterable_selection"
                                options="{'whitelist_fname': 'use_project_deadline_from_options'}" required="1" on_change="1" />
                            <field name="project_deadline" string="Deadline" invisible="is_days_relative_to_project_applicable" on_change="1" />
                            <field name="root_service_deadline" invisible="use_project_deadline_from != 'root'" />
                            <field name="days_relative_to_project" invisible="not is_days_relative_to_project_applicable"
                                on_change="1" />
                            <field name="deadline" readonly="1" invisible="not is_days_relative_to_project_applicable" />

                            <field name="unreviewed_message_count" string="Unreviewed Messages" invisible="not unreviewed_message_count" />
                            <button name="action_mark_external_messages_reviewed" type="object" class="btn-primary"
                                invisible="not unreviewed_message_count"
                                string="Mark as Reviewed" icon="fa-check" help="Review the External Messages in the Chatter,
                                    and once done and followup is complete, mark them as Reviewed" />
                        </group>
                    </group>
                    <notebook>
                        <!-- <page string="Date Details" name="date_details">
                            <group>
                                <field name="is_days_relative_to_project_applicable" invisible="1" />
                                <field name="use_project_deadline_from_options" invisible="1" />
                                <field name="use_project_deadline_from" widget="filterable_selection"
                                    options="{'whitelist_fname': 'use_project_deadline_from_options'}" required="1" on_change="1" />
                                <field name="project_deadline" string="Deadline" invisible="is_days_relative_to_project_applicable" on_change="1" />
                                <field name="root_service_deadline" invisible="use_project_deadline_from != 'root'" />
                                <field name="days_relative_to_project" invisible="not is_days_relative_to_project_applicable"
                                    on_change="1" />
                                <field name="deadline" readonly="1" invisible="not is_days_relative_to_project_applicable" />
                            </group>
                        </page> -->

                        <page string="Supply Order" name="supply_order" invisible="not is_supply_order">
                            <group>
                                <group>
                                    <field name="supplier_partner_id" />
                                </group>
                                <group>
                                    <field name="supply_order_instructions" />
                                </group>
                            </group>
                            <group string="Legs">
                                <field name="leg_ids" nolabel="1">
                                    <list>
                                        <field name="sequence" widget="handle" />
                                        <field name="supply_from" />
                                        <field name="supply_to" />
                                        <field name="supply_instructions" />
                                        <field name="supply_cost_currency_id" column_invisible="1" />
                                        <field name="supply_cost_amount" sum="Total Cost" currency_field="supply_cost_currency_id" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <!-- invisible: keep UI simple. The cog menu still allows creating child services -->
                        <page string="Child Services" name="services" invisible="not descendant_ids">
                            <div>
                                <button name="add_child_service" type="object" data-hotkey="n"
                                    icon="fa-plus">
                                    Add Child Service</button>
                            </div>
                            <field name="descendant_ids" widget="riverflow_one2many" invisible="not descendant_ids">
                                <!-- Workaround: list view click opens a popup of the child service, instead of the form view.
                                 To ensure the form view opens for the child service, we use riverflow_one2many -->
                                <list create="0" delete="0" edit="0">
                                    <field name="active" column_invisible="True" />
                                    <field name='indented_name' optional="show" width="260px" />
                                    <field name="display_name" optional="hide" />
                                    <field name="root_name" optional="hide" />
                                    <field name="transition_buttons_json" widget="transition_buttons" width="240px" optional="hide" />
                                    <field name="state_id" width="140px" optional="show" />
                                    <field name="timing_json" widget="timing_widget" optional="show" />
                                    <field name="deadline" optional="hide" />
                                    <field name="responsible_team_id" string="Responsible" width="120px" optional="show" />
                                    <field name="write_uid" string="Updated By" optional="hide" />
                                    <field name="write_date" string="Updated On" optional="hide" />
                                    <field name="company_id" width="100px" optional="show" />
                                    <field name='internal_notes_summary' width="200px" optional="show" />
                                    <field name="external_messages_summary" width="200px" optional="show" />
                                    <field name="unreviewed_message_count" width="40px" optional="show" />
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                                        readonly="1" optional="show" />
                                </list>
                            </field>
                        </page>
                        <page string="Unreviewed External Messages" name="unreviewed_messages" groups="base.group_no_one">
                            <group>
                                <group>
                                    <button name="action_mark_external_messages_reviewed" type="object" class="btn-primary"
                                        string="Mark as Reviewed" icon="fa-check" help="Review the External Messages in the Chatter,
                                    and once done and followup is complete, mark them as Reviewed" />
                                </group>
                                <group>
                                    <field name="unreviewed_message_count" string="Unreviewed Messages" />
                                    <field name="last_external_message_review_time" invisible="last_external_message_review_time == False" string="Last Reviewed" />
                                </group>
                            </group>
                            <group>
                                <field name="message_from_external_sender_ids">
                                    <list>
                                        <field name="date" />
                                        <field name="author_id" />
                                        <field name="email_from" />
                                        <field name="subject" />
                                        <field name="preview" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="External Messages" name="all_external_messages" invisible="1">
                            <span>Messages visible to third parties (customers, vendors, etc.),
                                or received from third party.</span>
                            <group>
                                <field name="external_messages_summary" />

                                <field name="external_message_ids" />
                            </group>
                        </page>
                        <page string="Internal Notes" name="internal_notes" invisible="1">
                            <field name="internal_note_ids" />
                        </page>
                        <page string="Template Settings" name="template_settings" invisible="not is_root_a_template">
                            <group>
                                <group string="Email Settings">
                                    <field name="email_template_id" />
                                    <field name="add_operator_as_recipient" />
                                </group>
                                <group string="Supply Order Settings">
                                    <field name="is_supply_order" />
                                </group>
                                <group string="Template Settings" groups="base.group_no_one">
                                    <field name="is_root_a_template" />
                                    <field name="is_this_a_template" />
                                </group>
                            </group>
                        </page>
                        <page string="Workflow Override" name="workflow" groups="base.group_no_one">
                            <group>
                                <field name="workflow_id" on_change="1" options="{'no_create': True}" />
                                <field name="state_id" on_change="1" options="{'no_create': True}" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True" />
            </form>
        </field>
    </record>

    <!-- Add form view for service legs -->
    <record id="view_service_leg_form" model="ir.ui.view">
        <field name="name">riverflow.service.leg.form</field>
        <field name="model">riverflow.service.leg</field>
        <field name="arch" type="xml">
            <form string="Supply Leg">
                <sheet>
                    <group>
                        <group>
                            <field name="supply_from" />
                            <field name="supply_to" />
                            <field name="supply_instructions" />
                        </group>
                        <group>
                            <field name="supply_cost_amount" string="Cost" />
                            <field name="supply_cost_currency_id" invisible="1" />
                        </group>
                    </group>
                    <group colspan="2">
                        <field name="name" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id='service_view_list' model='ir.ui.view'>
        <field name='name'>riverflow.service.list</field>
        <field name='model'>riverflow.service</field>
        <field name='arch' type='xml'>
            <list create="false">
                <field name="active" column_invisible="True" />
                <field name='indented_name' optional="show" width="260px" />
                <field name="display_name" optional="hide" />
                <field name="root_name" optional="hide" />
                <field name="transition_buttons_json" widget="transition_buttons" width="240px" optional="hide" />
                <field name="state_id" width="140px" optional="show" />
                <field name="timing_json" widget="timing_widget" optional="show" />
                <field name="deadline" optional="hide" />
                <field name="res_name" optional="show" />
                <field name="responsible_team_id" string="Responsible" width="120px" optional="show" />
                <field name="write_uid" string="Updated By" optional="hide" />
                <field name="write_date" string="Updated On" optional="hide" />
                <field name="front_office_workflow_id" optional="hide" />
                <field name="company_id" width="100px" optional="show" />
                <field name='internal_notes_summary' width="200px" optional="show" />
                <field name="external_messages_summary" width="200px" optional="show" />
                <field name="unreviewed_message_count" width="40px" optional="show" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1" optional="show" />
            </list>
        </field>
    </record>

    <record id="service_view_search" model="ir.ui.view">
        <field name="name">riverflow.service.search</field>
        <field name="model">riverflow.service</field>
        <field name="arch" type="xml">
            <search string="Search Services">
                <field name="name" string="Name"
                    filter_domain="['|', ('name', 'ilike', self), ('display_name', 'ilike', self)]" />
                <field name="res_name" string="Subject" />
                <field name="workflow_id" />
                <field name="state_id" />
                <field name="tag_ids" />
                <field name="project_deadline" />
                <field name="internal_notes_summary" string="Internal Notes" />
                <field name="external_messages_summary" string="External Messages" />
                <field name="responsible_team_id" />
                <field name="company_id" />
                <separator />
                <filter string="Standalone Services" name="standalone_services" domain="[('res_model', '=', False)]" />
                <filter string="Linked Services" name="linked_services" domain="[('res_model', '!=', False)]" />
                <separator />
                <filter string="Workflow Pending" name="pending" domain="[('is_end_state', '=', False)]" />
                <filter string="Workflow Completed" name="completed" domain="[('is_end_state', '=', True)]" />
                <filter string="Archived" name="archived" domain="[('active', '=', False)]" />
                <separator />
                <filter string="Deadline" name="deadline" date="project_deadline" />
                <separator />
                <filter string="Overdue" name="overdue" domain="[('project_deadline', '&lt;', context_today().strftime('%Y-%m-%d')),('is_end_state', '=', False)]" />
                <filter string="Today" name="today" domain="[('project_deadline', '=', context_today().strftime('%Y-%m-%d')),('is_end_state', '=', False)]" />
                <filter string="Upcoming" name="upcoming" domain="[('project_deadline', '&gt;', context_today().strftime('%Y-%m-%d')),('is_end_state', '=', False)]" />
                <separator />
                <filter string="Needs Review" name="needs_review" domain="[('unreviewed_message_count', '&gt;', 0)]" />
                <filter string="Has Internal Notes" name="has_internal_notes"
                    domain="[('internal_notes_summary', '!=', False), ('internal_notes_summary', '!=', '')]" />
                <filter string="Has External Messages" name="has_external_messages"
                    domain="[('external_messages_summary', '!=', False), ('external_messages_summary', '!=', '')]" />
                <group expand="0" string="Group By">
                    <!-- <filter string="Deadline" name="group_by_deadline" context="{'group_by': 'project_deadline'}" /> -->
                    <filter string="Responsible Team" name="group_by_responsible_team" context="{'group_by': 'responsible_team_id'}" />
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" />
                    <filter string="Workflow" name="group_by_workflow" context="{'group_by': 'workflow_id'}" />
                    <filter string="State" name="group_by_state" context="{'group_by': 'state_id'}" />
                    <filter string="Subject" name="group_by_subject" context="{'group_by': 'res_name'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="path">services</field>
        <field name="res_model">riverflow.service</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="riverflow.service_view_search" />
        <field name="domain">[('is_root_a_template', '=', False)]</field>
        <field name="context">{'default_is_this_a_template': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new service!
            </p>
        </field>
    </record>


    <record id="action_service_templates" model="ir.actions.act_window">
        <field name="name">Service Templates</field>
        <field name="path">service-template</field>
        <field name="res_model">riverflow.service</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="riverflow.service_view_search" />
        <field name="domain">[('is_root_a_template', '=', True)]</field>
        <field name="context">{'default_is_this_a_template': True}</field>
    </record>

    <record id="service_tag_view_view_form" model="ir.ui.view">
        <field name="name">riverflow.service.tag.form</field>
        <field name="model">riverflow.service.tag</field>
        <field name="arch" type="xml">
            <form string="Service Tags">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_tag_view_view_list" model="ir.ui.view">
        <field name="name">riverflow.service.tag.list</field>
        <field name="model">riverflow.service.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <record id="service_tag_action" model="ir.actions.act_window">
        <field name="name">Service Tags</field>
        <field name="path">service-tags</field>
        <field name="res_model">riverflow.service.tag</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new service tag!
            </p>
        </field>
    </record>

    <!-- Define the action for the service start transition wizard -->
    <record id="action_riverflow_start_service" model="ir.actions.act_window">
        <field name="name">New Service</field>
        <field name="path">start-service</field>
        <field name="res_model">riverflow.start.service</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_riverflow_start_template" model="ir.actions.act_window">
        <field name="name">New Service Template</field>
        <field name="path">start-template</field>
        <field name="res_model">riverflow.start.service</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_is_this_a_template': True}</field>
    </record>

    <!-- Menu Item Definitions 
    https://www.svgrepo.com/svg/455931/service-bell?edit=true 
    -->
    <menuitem id='riverflow.service_root' name='Services'
        web_icon='riverflow,static/description/icon.png' sequence="10">
        <menuitem id="riverflow.services_menu" name="Services" action="riverflow.service_action" sequence="10" />
        <menuitem id="riverflow.services_configuration_menu" name="Configuration" sequence="20">
            <menuitem id="riverflow.services_menu_configuration_tags"
                action="riverflow.service_tag_action" sequence="10" />
            <menuitem id="riverflow.services_menu_configuration_templates"
                action="riverflow.action_service_templates" sequence="200" />
            <menuitem id="riverflow.service_menu_start_template" name="&#10133; New Template"
                action="riverflow.action_riverflow_start_template" sequence="210" />
        </menuitem>
        <menuitem id="riverflow.service_menu_new_service" name="&#10133; New Service"
            action="riverflow.action_riverflow_start_service" sequence="30" />
    </menuitem>

    <record id="action_send_dummy_external_message" model="ir.actions.server">
        <field name="name">Create Dummy External Message</field>
        <field name="model_id" ref="model_riverflow_service" />
        <field name="binding_model_id" ref="model_riverflow_service" />
        <field name="state">code</field>
        <field name="code">
            for record in records:
            record._send_dummy_external_message()
        </field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]" />
    </record>

    <record id="action_add_child_service" model="ir.actions.server">
        <field name="name">Add Child Service</field>
        <field name="model_id" ref="model_riverflow_service" />
        <field name="binding_model_id" ref="model_riverflow_service" />
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.add_child_service()</field>
    </record>


</odoo>