<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="riverflow.TransitionButtons.IconAndCaption">
        <t t-if="this.iconClass()">
            <span t-att-class="this.iconClass()"></span>
            <span>&#160;</span>
        </t>
        <span t-att-class="this.stateClass()" t-esc="this.text()" />
    </t>
    <t t-name="riverflow.TransitionButtons">
        <t t-if="this.useFullListLayout()">
            <div class="transition-selection-group full-list-layout">
                <div class="row">
                    <!-- Left column for templates -->
                    <div t-attf-class="col-#{this.buttonDefs().some(button => !button.is_template) ? '6' : '12'}">
                        <t t-if="this.buttonDefs().some(button => button.is_template)">
                            <h3>Select one or more service templates</h3>
                            <div class="row mb-2">
                                <div class="col-12">
                                    <input
                                        type="text"
                                        class="form-control transition-search-input"
                                        t-att-value="state.searchQuery"
                                        t-on-input="(ev) => this.onSearchInput(ev.target.value)"
                                        placeholder="Search..."
                                    />
                                </div>
                            </div>
                            <div class="template-list-scroll">
                                <t t-foreach="this.buttonDefs()" t-as="button" t-key="button.index">
                                    <t t-if="button.is_template">
                                        <div t-attf-class="template-item indent-#{button.indent_level}"
                                            t-att-style="this.filteredByQuery(button) and this.shouldShowButton(button) ? '' : 'display: none;'">
                                            <t t-if="button.indent_level === 0">
                                                <input type="checkbox"
                                                    t-att-id="button.index"
                                                    t-att-checked="button.checked"
                                                    t-on-click="() => this.toggleCheckbox(button.index)" />
                                            </t>
                                            <label t-att-for="button.index">
                                                <span t-att-class="this.buttonIconClass(button)" />
                                                <span t-esc="button.caption" t-att-title="button.caption" />
                                                <t t-if="button.indent_level === 0 and this.hasChildren(button)">
                                                    <i t-attf-class="fa fa-chevron-#{this.isTemplateExpanded(button.index) ? 'down' : 'right'}"
                                                        t-on-click.stop="() => this.toggleTemplateExpansion(button.index)" />
                                                </t>
                                            </label>
                                        </div>
                                    </t>
                                </t>
                            </div>
                            <br />
                            <div>
                                <div class="row mb-3">
                                    <label class="col-3 col-form-label">Deadline</label>
                                    <div class="col-9">
                                        <DateTimeInput
                                            type="'date'"
                                            value="state.projectDeadline"
                                            onChange.bind="onDeadlineChanged"
                                            placeholder="'Select deadline date'"
                                        />
                                    </div>
                                </div>
                                <button class="btn btn-primary" t-on-click.prevent="() => this.executeSelectedTransitions()" accesskey="s">Create</button>
                            </div>
                        </t>
                    </div>

                    <!-- Right column for non-templates -->
                    <div t-attf-class="col-#{this.buttonDefs().some(button => button.is_template) ? '6' : '12'}">
                        <t t-if="this.buttonDefs().some(button => !button.is_template)">
                            <t t-if="this.buttonDefs().some(button => button.is_template)">
                                <h3>Or click an item below to create a blank service</h3>
                            </t>
                            <t t-foreach="this.buttonDefs()" t-as="button" t-key="button.index">
                                <t t-if="!button.is_template">
                                    <div t-attf-class="service-item indent-#{button.indent_level}">
                                        <button
                                            t-att-name="button.action"
                                            class="btn btn-link transition_button"
                                            t-on-click.stop="() => this.executeTransition(button)"
                                            type="object">
                                            <span t-att-class="this.buttonIconClass(button)" />
                                            <span t-esc="button.caption" t-att-title="button.caption" />
                                        </button>
                                    </div>
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </t>
        <t t-elif="this.useFormHeaderLayout()">
            <div class="button-separator-group">
                <t t-foreach="this.buttonDefs()" t-as="button" t-key="button.index">
                    <button
                        t-att-name="button.action"
                        t-attf-class="btn #{button.index === 0 ? 'btn-primary' : 'btn-secondary'}"
                        t-on-click.stop="() => this.executeTransition(button)"
                        type="object">
                        <span t-esc="button.caption" t-att-title="button.caption" />
                    </button>
                    <t t-if="button.index &lt; this.buttonDefs().length - 1">
                        <span class="mx-1"></span>
                    </t>
                </t>
            </div>
            <!-- <div class="d-flex align-items-center">
                <t t-if="this.iconClass()">
                    <span t-att-class="this.iconClass()"></span>
                    <span>&#160;</span>
                </t>
                <span t-att-class="this.stateClass()" t-esc="this.fieldValueState.workflow_name" />
            </div> -->
        </t>
        <t t-else="">
            <t t-if="this.buttonDefs().length > this.maxButtons()">
                <span t-on-click.stop="onSpanClick">
                    <t t-call="riverflow.TransitionButtons.IconAndCaption" />
                </span>
                <div class="transition-selection-group">
                    <input t-ref="inputElement" class="o_input riverflow_input_dropdown__input"
                        t-on-click.stop="() => {}"
                        t-on-change="(ev) => this.onTransitionChange(ev)"
                        t-att-list="this.datalistId()"
                        placeholder="Select an action"
                        autocomplete="on" />
                    <span class="riverflow_input_dropdown__arrow"></span>
                    <datalist t-att-id="this.datalistId()">
                        <t t-foreach="this.buttonDefs()" t-as="button" t-key="button.index">
                            <option t-att-value="button.caption" t-att-data-index="button.index" />
                        </t>
                    </datalist>
                </div>
            </t>
            <t t-else="">
                <t t-call="riverflow.TransitionButtons.IconAndCaption" />
                <div class="button-separator-group">
                    <t t-foreach="this.buttonDefs()" t-as="button" t-key="button.index">
                        <button
                            t-att-name="button.action"
                            class="btn btn-link transition_button"
                            t-on-click.stop="() => this.executeTransition(button)"
                            type="object">
                            <span t-esc="button.caption" t-att-title="button.caption" />
                        </button>
                        <t t-if="button.index &lt; this.buttonDefs().length - 1">
                            <span class="button-separator">&#160;|</span>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </t>
</templates>