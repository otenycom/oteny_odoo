<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="oteny_shortcut.ViewShortcutsBanner">
        <div t-if="state.loaded and state.shortcuts.length" class="view-shortcuts-banner mx-3 mt-2 mb-1 d-flex gap-2 flex-wrap align-items-center">
            <t t-foreach="state.shortcuts" t-as="shortcut" t-key="shortcut.id">
                <button
                    t-attf-class="btn btn-sm #{this.isActive(shortcut) ? 'btn-primary' : 'btn-outline-secondary'}"
                    t-on-click="() => this.onShortcutClick(shortcut)">
                    <i t-if="shortcut.shortcut_icon" t-attf-class="fa #{shortcut.shortcut_icon} me-1"/>
                    <i t-if="shortcut.shortcut_view_type === 'calendar'" class="fa fa-calendar-o me-1 opacity-50"/>
                    <i t-elif="shortcut.shortcut_view_type === 'list'" class="fa fa-list me-1 opacity-50"/>
                    <t t-esc="shortcut.name"/>
                </button>
            </t>
        </div>
    </t>

</templates>
