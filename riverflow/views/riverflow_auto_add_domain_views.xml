<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_add_domain_form" model="ir.ui.view">
        <field name="name">riverflow.auto.add.domain.form</field>
        <field name="model">riverflow.auto.add.domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="name" />
                        </h2>
                    </div>
                    <group>
                        <field name="applies_to_model_id" />
                        <field name="applies_to_model" readonly="1" invisible="1" />
                        <field name="domain" widget="domain" options="{'model': 'applies_to_model'}" />
                        <field name="description" placeholder="Human-readable description of the domain condition." />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_auto_add_domain_list" model="ir.ui.view">
        <field name="name">riverflow.auto.add.domain.list</field>
        <field name="model">riverflow.auto.add.domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="applies_to_model_id" optional="show" />
                <field name="name" optional="show" />
                <field name="description" optional="show" />
                <field name="domain" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_auto_add_domain_search" model="ir.ui.view">
        <field name="name">riverflow.auto.add.domain.search</field>
        <field name="model">riverflow.auto.add.domain</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="applies_to_model_id" />
            </search>
        </field>
    </record>

    <record id="action_auto_add_domain" model="ir.actions.act_window">
        <field name="name">Auto Add Domains</field>
        <field name="res_model">riverflow.auto.add.domain</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_auto_add_domain_search" />
    </record>

    <menuitem id="menu_auto_add_domain"
        name="Auto Add Domains"
        action="action_auto_add_domain"
        parent="riverflow.services_configuration_menu" sequence="100"
    />
</odoo>