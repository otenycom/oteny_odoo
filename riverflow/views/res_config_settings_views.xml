<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.riverflow</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <t groups="base.group_user">
                    <app data-string="Riverflow" string="Riverflow" name="riverflow" groups="base.group_user">
                        <block title="Riverflow Settings" name="riverflow_setting_container">
                            <setting string="Email Domain Restriction" help="Set allowed email domains for recipients">
                                <field name="restrict_email_recipients_to" class="o_field_char" style="width: 100%;" />
                                <div class="text-muted mt8">
                                    Comma-separated list of allowed email domains (e.g., example.com,example.org)
                                </div>
                            </setting>
                        </block>
                    </app>
                </t>
            </xpath>
        </field>
    </record>
</odoo>