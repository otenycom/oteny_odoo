<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_service_reader" model="res.groups">
            <field name="name">Reader</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="group_service_writer" model="res.groups">
            <field name="name">Writer</field>
            <field name="implied_ids" eval="[(4, ref('group_service_reader'))]" />
        </record>

        <record id="group_service_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_service_writer'))]" />
            <!-- Auto adds the admin user to the manager group -->
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
        </record>
    </data>

    <data noupdate="0">
        <!-- Multi-company rules -->
        <record id="riverflow_state_record_comp_rule" model="ir.rule">
            <field name="name">State Record Multi-company</field>
            <field name="model_id" ref="model_riverflow_state_record" />
            <field name="domain_force">['|', ('company_id', 'parent_of', company_ids), ('company_id', '=', False)]</field>
            <field name="global" eval="True" />
        </record>

        <record id="riverflow_service_comp_rule" model="ir.rule">
            <field name="name">Service Multi-company</field>
            <field name="model_id" ref="model_riverflow_service" />
            <field name="domain_force">['|', ('company_id', 'parent_of', company_ids), ('company_id', '=', False)]</field>
        </record>

        <record id="riverflow_team_comp_rule" model="ir.rule">
            <field name="name">Team Multi-company</field>
            <field name="model_id" ref="model_riverflow_team" />
            <field name="domain_force">['|', ('company_id', 'parent_of', company_ids), ('company_id', '=', False)]</field>
        </record>
    </data>
</odoo>