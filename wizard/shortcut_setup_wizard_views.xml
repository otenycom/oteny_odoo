<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="shortcut_setup_wizard_view_form" model="ir.ui.view">
        <field name="name">shortcut.setup.wizard.form</field>
        <field name="model">shortcut.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Up Shortcut">
                <group>
                    <field name="filter_id" />
                    <field name="res_model" invisible="1" />
                    <field name="subject_model_ids" invisible="1" />
                    <field name="is_shortcut" widget="boolean_toggle" />
                    <field name="show_preset" widget="radio" invisible="not is_shortcut" required="is_shortcut" />
                    <field name="subject_model_id"
                           invisible="not is_shortcut or show_preset != 'subject'"
                           required="is_shortcut and show_preset == 'subject'"
                           domain="[('id', 'in', subject_model_ids)]"
                           options="{'no_create': True, 'no_open': True}" />
                    <!-- The expression itself only for a custom choice, and only in
                         debug mode: the presets cover the usual cases without it. -->
                    <field name="shortcut_show_when" widget="code" options="{'mode': 'python'}"
                           invisible="not is_shortcut or show_preset != 'custom'"
                           groups="base.group_no_one" />
                    <field name="shortcut_icon" widget="fa_icon" invisible="not is_shortcut" />
                    <field name="is_default" />
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
