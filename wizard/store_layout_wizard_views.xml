<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="store_layout_wizard_view_form" model="ir.ui.view">
        <field name="name">shortcut.store.layout.wizard.form</field>
        <field name="model">shortcut.store.layout.wizard</field>
        <field name="arch" type="xml">
            <form string="Store Layout">
                <group>
                    <field name="filter_id" />
                    <field name="layout_summary" nolabel="1" colspan="2" />
                    <field name="layout_json" invisible="1" />
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
