<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Audit Log Cleanup Cron Job -->
    <record id="ir_cron_audit_log_cleanup" model="ir.cron">
        <field name="name">Audit Log: Cleanup Old Records</field>
        <field name="model_id" ref="model_oteny_audit_log" />
        <field name="state">code</field>
        <field name="code">model.cleanup_old_audit_logs()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="priority">100</field>
    </record>

</odoo>